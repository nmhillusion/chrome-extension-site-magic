{
  "manifest_version": 3,
  "name": "Site Style Weaver",
  "version": "1.0",
  "description": "Weave custom styles into any website — fonts, colors, spacing and more.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "sidePanel"],
  "action": {
    "default_title": "Site Style Weaver",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
